NEXT_PUBLIC_BACKEND_URL=https://backend-beta.grbpwr.com
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=...
NEXT_PUBLIC_GTM_ID=GTM-...

# Exact HTTPS origins allowed to embed /preview/*. Empty keeps the prod + beta defaults.
NEXT_PUBLIC_ADMIN_ORIGINS=
# Set to beta, beta-NN, preview, staging, test, development, dev or local to disable indexing.
# Empty and unknown values preserve the existing production-safe indexing behaviour.
NEXT_PUBLIC_SITE_ENV=

# Sentry error reporting. Empty = off: no SDK loads and nothing is sent. Set in Vercel (Production and Preview).
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_DSN=
# Build only, optional: upload source maps (all three needed).
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=

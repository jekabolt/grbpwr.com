NEXT_PUBLIC_BACKEND_URL=https://api.beta.lekalo.studio
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=...
NEXT_PUBLIC_GTM_ID=GTM-...

# Exact HTTPS origins allowed to embed /preview/*. Empty keeps the prod + beta defaults.
NEXT_PUBLIC_ADMIN_ORIGINS=
# Set to beta, beta-NN, preview, staging, test, development, dev or local to disable indexing.
# Empty and unknown values preserve the existing production-safe indexing behaviour.
NEXT_PUBLIC_SITE_ENV=

# Sentry error reporting. Empty = off: no SDK loads and nothing is sent. Set in Vercel (Production and Preview).
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_DSN=
# Build only, optional: upload source maps (all three needed).
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=

# lekalo-shop (multi-shop). The request host picks the shop; on localhost and
# *.vercel.app previews this host is used instead (ignored on real shop hosts).
NEXT_PUBLIC_SHOP_DEV_HOST=
# Master for per-shop revalidation secrets: HKDF-SHA256(master, "revalidate:"+shopKey).
# Same value as the backend's SHOP_REVALIDATE_MASTER. Server only, never NEXT_PUBLIC.
SHOP_REVALIDATE_MASTER=
# Hosts serving shop media (next/image + CSP), comma list, "*." allowed.
NEXT_PUBLIC_MEDIA_HOSTS=
